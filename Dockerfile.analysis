FROM python:3.13-slim

WORKDIR /app
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt

RUN groupadd --system cuevision && useradd --system --gid cuevision cuevision
COPY pool_ai_full/ ./pool_ai_full/
USER cuevision

ENV HOST=0.0.0.0 PORT=8080 PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "pool_ai_full.server"]
